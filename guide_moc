.moc-guide *::before,
.moc-guide *::after{box-sizing:border-box;}

.moc-guide{
  width:980px;
  max-width:100%;
  margin:20px auto;
  padding:24px;
  display:flex;
  gap:28px;
  position:relative;
  overflow:hidden;
  background:linear-gradient(180deg,rgba(10,16,40,.96) 0%,rgba(16,26,61,.98) 100%);
  border:1px solid rgba(194,163,104,.45);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.03),0 0 30px rgba(0,0,0,.35);
  color:#eadcc0;
  font-family:Georgia,"Times New Roman",serif;
}

.moc-guide::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:linear-gradient(180deg,rgba(255,255,255,.03),transparent 20%),radial-gradient(circle at center,rgba(255,255,255,.03),transparent 45%);
}

.moc-guide > *{position:relative;z-index:1;}

.moc-menu{
  width:250px;
  flex:0 0 250px;
  padding:14px 10px;
  background:rgba(9,15,37,.72);
  border:1px solid rgba(194,163,104,.25);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.02);
}

.moc-menu button{
  position:relative;
  display:block;
  width:100%;
  margin:3px 0;
  padding:3px 26px;
  border:0;
  background:transparent;
  color:#e4d3b4;
  font:700 13px/1.2 Georgia,"Times New Roman",serif;
  letter-spacing:.03em;
  text-align:left;
  cursor:pointer;
}

.moc-menu button::before{
  content:"";
  position:absolute;
  left:8px;
  top:50%;
  width:9px;
  height:2px;
  background:#c2a368;
  transform:translateY(-50%);
  box-shadow:0 0 6px rgba(194,163,104,.35);
}

.moc-menu button:hover{color:#d3b072;}

.moc-parent::after{
  content:"▾";
  position:absolute;
  right:8px;
  top:50%;
  color:#7f89b8;
  font-size:11px;
  transform:translateY(-50%);
  transition:.2s ease;
}

.moc-menu-group.open .moc-parent::after{
  color:#d3b072;
  transform:translateY(-50%) rotate(180deg);
}

.moc-submenu{
  display:none;
}

.moc-menu-group.open .moc-submenu{
  display:block;
}

.moc-submenu button{
  padding-left:38px;
  color:#99a4b0;
  font-size:12px;
}

.moc-submenu button::before{
  content:"✦";
  left:20px;
  width:auto;
  height:auto;
  background:transparent;
  color:#c2a368;
  font-size:9px;
  box-shadow:none;
}

.moc-content{
  flex:1;
  min-height:420px;
  padding:25px;
  background:linear-gradient(180deg,#1A2342 0%,#141b34 100%);
  border:1px solid rgba(194,163,104,.45);
  color:#e4d3b4;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.03);
  overflow:hidden;
}

.moc-tab{display:none;}
.moc-tab.active{display:block;}

.moc-subtitle{
  margin-bottom:10px;
  color:#99a4b0;
  font-size:10px;
  letter-spacing:.35em;
  text-transform:uppercase;
}

.moc-tab h2{
  margin:0 0 14px;
  padding-bottom:10px;
  border-bottom:1px solid rgba(194,163,104,.22);
  color:#d3b072;
  font-family:"Cinzel Decorative",Georgia,serif;
  font-size:24px;
  font-weight:400;
  letter-spacing:.04em;
  text-transform:uppercase;
}

.moc-tab h2::before{content:"✦ ";font-size:14px;}
.moc-tab p{line-height:1.8;color:#e7d9be;text-align:justify;}

.moc-intro{margin-bottom:26px;}

.moc-warning{
  margin-bottom:28px;
  padding:14px 16px;
  border:1px solid rgba(180,30,45,.85);
  background:#51446f;
  color:#ffb3b8;
  font-size:13px;
  font-weight:700;
  letter-spacing:.05em;
  text-align:center;
  text-shadow:0 0 6px rgba(255,70,90,.55),0 0 12px rgba(255,40,60,.35);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.03),0 0 12px rgba(180,30,45,.65),0 0 28px rgba(180,30,45,.45);
  animation:mocRedPulse 1.8s ease-in-out infinite;
}

.moc-warning strong{color:#ffd2d5;}

@keyframes mocRedPulse{
  0%,100%{box-shadow:inset 0 0 0 1px rgba(255,255,255,.03),0 0 10px rgba(180,30,45,.45),0 0 22px rgba(180,30,45,.25);}
  50%{box-shadow:inset 0 0 0 1px rgba(255,255,255,.04),0 0 18px rgba(255,60,80,.85),0 0 40px rgba(255,60,80,.55);}
}

.moc-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
}

.moc-card,
.moc-box{
  padding:18px;
  border:1px solid rgba(194,163,104,.25);
  background:rgba(9,15,37,.72);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.02);
}

.moc-card.full,
.moc-grid .full{grid-column:1/-1;}

.moc-card-title{
  margin-bottom:14px;
  color:#d3b072;
  font-family:"Cinzel Decorative",Georgia,serif;
  font-size:18px;
  letter-spacing:.04em;
  text-align:center;
  text-transform:uppercase;
}

.moc-links{display:flex;flex-direction:column;gap:12px;}

.moc-links a{
  display:block;
  width:100%;
  padding:16px;
  border:1px solid #d7d0a8;
  background:#160706;
  color:#7f89b8!important;
  text-decoration:none!important;
  font-size:12px;
  text-align:center;
  transition:.25s ease;
}

.moc-links a:hover{
  background:#35514f;
  color:#fff1c9!important;
}

.moc-box{margin-top:22px;}

.moc-box h3{
  margin:0 0 8px;
  color:#d3b072;
  font-family:"Cinzel Decorative",Georgia,serif;
  font-size:24px;
  font-weight:400;
}

.moc-box span{
  display:block;
  margin-bottom:14px;
  color:#99a4b0;
  font-size:11px;
  letter-spacing:.18em;
  text-transform:uppercase;
}

.moc-box.legion{border-color:rgba(180,30,45,.45);}


.moc-banner{
  display:block;
  width:100%;
  margin:0 0 22px;
  border:1px solid rgba(194,163,104,.25);
}

.moc-table{
  width:100%;
  margin-top:18px;
  border-collapse:collapse;
  overflow:hidden;
  background:rgba(7,12,32,.82);
  border:1px solid rgba(194,163,104,.28);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.02);
}

.moc-table tr{
  transition:.2s ease;
}

.moc-table tr:nth-child(even){
  background:rgba(255,255,255,.02);
}

.moc-table tr:hover{
  background:rgba(194,163,104,.06);
}

.moc-table th{
  padding:14px 16px;
  border-bottom:1px solid rgba(194,163,104,.28);
  color:#d3b072;
  font-family:"Cinzel Decorative",Georgia,serif;
  font-size:15px;
  font-weight:400;
  letter-spacing:.04em;
  text-align:left;
  text-transform:uppercase;
  background:rgba(255,255,255,.02);
}

.moc-table td{
  padding:12px 16px;
  border-bottom:1px solid rgba(255,255,255,.04);
  color:#e7d9be;
  font-size:14px;
  line-height:1.7;
  vertical-align:top;
}

.moc-table td:first-child{
  width:220px;
  color:#d3b072;
  font-weight:700;
}

.moc-table tr:last-child td{
  border-bottom:none;
}

@media(max-width:800px){

  .moc-table,
  .moc-table tbody,
  .moc-table tr,
  .moc-table td,
  .moc-table th{
    display:block;
    width:100%;
  }

  .moc-table thead{
    display:none;
  }

  .moc-table tr{
    margin-bottom:14px;
    border-bottom:1px solid rgba(194,163,104,.2);
  }

  .moc-table td{
    padding:10px 14px;
  }

  .moc-table td:first-child{
    width:100%;
    padding-bottom:4px;
    color:#d3b072;
    font-size:15px;
  }

}


.moc-creature-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
  margin-top:22px;
}

.moc-creature-card{
  position:relative;
  height:260px;
  overflow:hidden;
  border:1px solid rgba(194,163,104,.28);
  background:rgba(7,12,32,.82);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.02);
}

.moc-creature-card img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  filter:grayscale(.25) brightness(.75);
  transition:.35s ease;
}

.moc-creature-info{
  position:absolute;
  inset:0;
  padding:22px;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  background:linear-gradient(180deg,rgba(7,12,32,.05) 0%,rgba(7,12,32,.92) 100%);
  transform:translateY(62%);
  transition:.35s ease;
}

.moc-creature-info h3{
  margin:0 0 10px;
  color:#d3b072;
  font-family:"Cinzel Decorative",Georgia,serif;
  font-size:22px;
  font-weight:400;
}

.moc-creature-info p{
  margin:0;
  color:#e7d9be;
  font-size:13px;
  line-height:1.6;
  opacity:0;
  transition:.35s ease;
}

.moc-creature-card:hover img{
  filter:grayscale(.05) brightness(.45);
  transform:scale(1.05);
}

.moc-creature-card:hover .moc-creature-info{
  transform:translateY(0);
}

.moc-creature-card:hover .moc-creature-info p{
  opacity:1;
}

@media(max-width:800px){
  .moc-creature-grid{
    grid-template-columns:1fr;
  }
}
@media(max-width:800px){
  .moc-guide{display:block;padding:18px;}
  .moc-menu{width:100%;margin-bottom:18px;}
  .moc-grid{grid-template-columns:1fr;}
}
</style> <script>
function mocToggleMenu(btn){
  var group=btn.parentNode;
  var menu=group.parentNode;
  var groups=menu.getElementsByClassName('moc-menu-group');

  for(var i=0;i<groups.length;i++){
    if(groups[i]!==group){
      groups[i].className=groups[i].className.replace(' open','');
    }
  }

  if(group.className.indexOf('open')===-1){
    group.className += ' open';
  }else{
    group.className=group.className.replace(' open','');
  }
}

function mocTab(id){
  var guides=document.getElementsByClassName('moc-guide');
  if(!guides || !guides.length){return;}

  for(var g=0;g<guides.length;g++){
    var root=guides[g];
    var tabs=root.getElementsByClassName('moc-tab');

    for(var i=0;i<tabs.length;i++){
      tabs[i].className=tabs[i].className.replace(' active','');
      tabs[i].className=tabs[i].className.replace('active','');
    }

    var selected=root.querySelector('#'+id);
    if(selected){
      selected.className += ' active';
      var content=root.getElementsByClassName('moc-content')[0];
      if(content){content.scrollTop=0;}
    }
  }
}
</script>
